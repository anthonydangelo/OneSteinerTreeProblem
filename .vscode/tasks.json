{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build-debug",
            "type": "shell",
            "command": "g++",
            "args": [
                "-g", "-frounding-math", "-std=c++11", "-pthread",
                "src/OneSteinerTreeProblem.cpp", "src/ComputationResult.cpp", "src/OrientedDirichletCell.cpp", 
                "src/DelaunayTriEMST.cpp", "src/GeomMedianFinder.cpp", "src/PrettyPrint.cpp", "src/UtilityFunctions.cpp",
                "-o", "OneSteinerTreeProblem_d",
                "-static",
                "-L${env:CGAL_DIR}/lib",
                "-lCGAL_Core_d", 
                "-lCGAL_d", 
                "-lmpfr", 
                 "-lgmp", 
                 "-lboost_thread", 
                 "-lboost_system",
                 "-lpthread" 
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "clear": true
            },
            "problemMatcher":"$gcc"            
        },
        {
            "label": "build-release",
            "type": "shell",
            "command": "g++",
            "args": [
                "-O2", "-frounding-math", "-std=c++11", "-Wall", "-Wextra", "-pthread",
                "src/OneSteinerTreeProblem.cpp", "src/ComputationResult.cpp", "src/OrientedDirichletCell.cpp", 
                "src/DelaunayTriEMST.cpp", "src/GeomMedianFinder.cpp", "src/PrettyPrint.cpp", "src/UtilityFunctions.cpp",
                "-o", "OneSteinerTreeProblem",
                "-static",
                "-L${env:CGAL_DIR}/lib",
                "-lCGAL_Core", 
                "-lCGAL", 
                "-lmpfr", 
                 "-lgmp", 
                 "-lboost_thread", 
                 "-lboost_system",
                 "-lpthread" 
            ],
            "group": "build",
            "presentation": {
                "clear": true
            },
            "problemMatcher":"$gcc"            
        },
        {
            "label": "build-perf",
            "type": "shell",
            "command": "g++",
            "args": [
                "-O2", "-g", "-fno-omit-frame-pointer", "-frounding-math", "-std=c++11", "-Wall", "-Wextra", "-pthread",
                "src/OneSteinerTreeProblem.cpp", "src/ComputationResult.cpp", "src/OrientedDirichletCell.cpp", 
                "src/DelaunayTriEMST.cpp", "src/GeomMedianFinder.cpp", "src/PrettyPrint.cpp", "src/UtilityFunctions.cpp",
                "-o", "OneSteinerTreeProblem-perf",
                "-static",
                "-L${env:CGAL_DIR}/lib",
                "-lCGAL_Core", 
                "-lCGAL", 
                "-lmpfr", 
                 "-lgmp", 
                 "-lboost_thread", 
                 "-lboost_system",
                 "-lpthread"
            ],
            "group": "build",
            "presentation": {
                "clear": true
            },
            "problemMatcher":"$gcc"            
        } 
    ]
}
